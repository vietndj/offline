{
  "name": "30ngayviral-fedu-vn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite@7.3.2 --config vite.config.ts --host 0.0.0.0",
    "build": "npx vite@7.3.2 build --config vite.config.ts",
    "serve": "npx vite@7.3.2 preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node tests/e2e/runner.mjs",
    "deploy:prebuilt": "npx vercel build --prod --yes && npx vercel deploy --prebuilt --prod --yes",
    "deploy": "npm run typecheck && npm run test:e2e && npm run deploy:prebuilt",
    "deploy:fast": "npm run deploy:prebuilt"
  },
  "dependencies": {
    "@vercel/node": "^5.8.23",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "googleapis": "^178.0.0",
    "lucide-react": "^1.38.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
